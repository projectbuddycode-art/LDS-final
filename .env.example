# Server-only Resend settings. Copy into .env.local — never commit real values.
# Do not prefix these names with NEXT_PUBLIC_.
#
# Vercel: add these as encrypted variables in every environment that sends inquiries,
# especially Production. Redeploy after changing them. INQUIRY_FROM_EMAIL must be a
# real sender address authorized by Resend.
# Notifications are sent to the two LDS team inboxes specified in the server handler.

RESEND_API_KEY=
INQUIRY_FROM_EMAIL=Lukhdatar & Sons <noreply@your-verified-domain.com>
